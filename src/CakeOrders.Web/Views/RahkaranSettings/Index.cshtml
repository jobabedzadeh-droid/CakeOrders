@model CakeOrders.Web.ViewModels.Integrations.Rahkaran.RahkaranSettingsViewModel

@{
    ViewData["Title"] = "تنظیمات راهکاران";
    var messages = ViewData["RahkaranMessages"] as List<string> ?? new List<string>();
    var successCount = ViewData["RahkaranSuccessCount"] as int? ?? 0;
}

<div class="page-heading">
    <div>
        <span class="eyebrow">RAHKARAN INTEGRATION</span>
        <h1>تنظیمات اتصال راهکاران</h1>
        <p>دریافت اطلاعات پایه و تعیین نگاشت مالی سامانه CakeOrders</p>
    </div>
    <form asp-action="TestConnection" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-primary" type="submit">آزمایش ارتباط</button>
    </form>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert-success">@successMessage</div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert-danger">@errorMessage</div>
}

<section class="form-panel">
    <h2>فهرست کارکنان و کدهای معرف</h2>
    <p>
        فهرست کارکنان از سرویس منابع انسانی راهکاران دریافت و در جدول داخلی سامانه ذخیره می‌شود.
        جست‌وجوی کد معرف در فرم سفارش از همین اطلاعات داخلی انجام خواهد شد.
    </p>
    <div class="detail-grid">
        <div>
            <small>تعداد کارکنان ذخیره‌شده</small>
            <b>@Model.CachedEmployeeCount نفر</b>
        </div>
    </div>
    <form asp-action="SyncEmployees" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-primary" type="submit">دریافت و به‌روزرسانی فهرست از راهکاران</button>
    </form>
    <div class="calc-note">
        همگام‌سازی، کارکنان جدید را اضافه و اطلاعات کارکنان موجود را به‌روزرسانی می‌کند.
        اطلاعات قبلی که در پاسخ جدید راهکاران وجود نداشته باشند، حذف نخواهند شد.
    </div>
</section>

<section class="form-panel">
    <h2>همگام‌سازی اطلاعات مشتریان</h2>
    <p>
        اطلاعات مشتریان از سرویس اطلاعات پایه راهکاران دریافت و در جدول مشتریان سامانه ذخیره می‌شود.
        شناسه مشتری، شناسه شخص، شماره مشتری، کد تفصیلی، کدهای شناسایی، وضعیت و مشخصات تماس نگهداری می‌شوند.
        اطلاعات کامل پاسخ، از جمله فهرست نشانی‌ها و فیلدهای تکمیلی، نیز برای جلوگیری از حذف داده‌های ناشناخته حفظ می‌شود.
    </p>
    <form asp-controller="Customers" asp-action="SyncFromRahkaran" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-primary" type="submit">دریافت و همگام‌سازی مشتریان راهکاران</button>
    </form>
    <div class="calc-note">
        این عملیات فقط اطلاعات را از راهکاران می‌خواند و در CakeOrders ذخیره می‌کند.
        هیچ مشتری جدیدی در راهکاران ایجاد یا ویرایش نمی‌شود و هیچ سند مالی یا درخواست فروشی ثبت نخواهد شد.
        مشتریانی که شماره موبایل معتبر ندارند نیز با کلید داخلی مستقل ذخیره می‌شوند و در جست‌وجوی موبایل دخالت نمی‌کنند.
    </div>
</section>

<section class="form-panel">
    <h2>وضعیت اتصال</h2>
    <div class="detail-grid">
        <div>
            <small>نشانی سرویس</small>
            <b dir="ltr">@Model.ServiceBaseUrl</b>
        </div>
        <div>
            <small>وضعیت یکپارچه‌سازی عملیاتی</small>
            <b>@(Model.IntegrationEnabled ? "فعال" : "غیرفعال")</b>
        </div>
        <div>
            <small>وضعیت دریافت اطلاعات پایه</small>
            <b>@successCount از ۸ سرویس</b>
        </div>
    </div>
    @if (!Model.IntegrationEnabled)
    {
        <div class="calc-note">
            یکپارچه‌سازی عملیاتی خاموش است. این صفحه فقط اطلاعات پایه را می‌خواند و نگاشت‌ها را ذخیره می‌کند؛
            هیچ درخواست فروش یا سند مالی در راهکاران ثبت نمی‌شود.
        </div>
    }
    <ul class="rahkaran-api-messages">
        @foreach (var message in messages)
        {
            <li>@message</li>
        }
    </ul>
</section>

<section class="form-panel">
    <h2>کنترل آمادگی ارسال درخواست فروش</h2>
    <p>
        شناسه سفارش را وارد کنید تا پیش‌نیازهای ثبت درخواست فروش در راهکاران بررسی شوند.
        این کنترل فقط اطلاعات داخلی را می‌خواند و هیچ داده‌ای به راهکاران ارسال نمی‌کند.
    </p>
    <div class="form-grid">
        <div class="field">
            <label for="rahkaranReadinessOrderId">شناسه داخلی سفارش</label>
            <input id="rahkaranReadinessOrderId" type="number" min="1" step="1" placeholder="مثلاً 15" />
        </div>
        <div class="field" style="align-self:end">
            <button id="checkRahkaranReadiness" type="button" class="btn btn-primary">بررسی پیش‌نیازهای سفارش</button>
        </div>
    </div>
    <div id="rahkaranReadinessResult" class="calc-note" aria-live="polite" hidden></div>
</section>

<script>
(() => {
    const button = document.getElementById('checkRahkaranReadiness');
    const orderInput = document.getElementById('rahkaranReadinessOrderId');
    const result = document.getElementById('rahkaranReadinessResult');
    if (!button || !orderInput || !result) return;

    button.addEventListener('click', async () => {
        const orderId = Number.parseInt(orderInput.value, 10);
        result.hidden = false;
        result.textContent = 'در حال بررسی...';
        if (!Number.isInteger(orderId) || orderId <= 0) {
            result.textContent = 'شناسه داخلی سفارش را به‌درستی وارد کنید.';
            return;
        }

        button.disabled = true;
        try {
            const response = await fetch('@Url.Action("CheckSalesRequestReadiness", "RahkaranSettings")' + '?orderId=' + encodeURIComponent(orderId), {
                headers: { 'Accept': 'application/json' }
            });
            const data = await response.json();
            result.replaceChildren();

            const heading = document.createElement('strong');
            heading.textContent = data.ready ? 'تمام پیش‌نیازهای بررسی‌شده تکمیل هستند.' : 'ارسال درخواست فروش در وضعیت فعلی آماده نیست.';
            result.appendChild(heading);

            if (data.orderNumber) {
                const order = document.createElement('p');
                order.textContent = 'شماره سفارش: ' + data.orderNumber;
                result.appendChild(order);
            }

            const appendList = (title, items) => {
                if (!items || items.length === 0) return;
                const label = document.createElement('p');
                label.textContent = title;
                result.appendChild(label);
                const list = document.createElement('ul');
                items.forEach(item => {
                    const li = document.createElement('li');
                    li.textContent = item;
                    list.appendChild(li);
                });
                result.appendChild(list);
            };

            appendList('موارد تأییدشده:', data.checks);
            appendList('موارد نیازمند اصلاح:', data.issues);
            const note = document.createElement('p');
            note.textContent = data.note || 'این عملیات فقط خواندنی است.';
            result.appendChild(note);
            if (!response.ok && !data.issues) {
                result.firstChild.textContent = 'بررسی سفارش ناموفق بود.';
            }
        } catch {
            result.textContent = 'ارتباط با سامانه برای بررسی سفارش برقرار نشد.';
        } finally {
            button.disabled = false;
        }
    });
})();
</script>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()

    <section class="form-panel">
        <h2>تنظیمات دریافت نقدی بیعانه</h2>
        <p>این شناسه‌ها از فهرست‌های راهکاران انتخاب می‌شوند و مقدار نمونه یا ثابت در کد ندارند.</p>
        <div class="form-grid">
            <div class="field">
                <label asp-for="BranchId">شعبه راهکاران</label>
                <select asp-for="BranchId" asp-items="Model.Branches">
                    <option value="">انتخاب شعبه</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="CashId">صندوق دریافت</label>
                <select asp-for="CashId" asp-items="Model.Cashes">
                    <option value="">انتخاب صندوق</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="CashAccountingOperationId">عملیات حسابداری نقدی</label>
                <select asp-for="CashAccountingOperationId" asp-items="Model.AccountingOperations">
                    <option value="">انتخاب عملیات حسابداری</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="CashFlowFactorId">عامل گردش نقدینگی نقدی</label>
                <select asp-for="CashFlowFactorId" asp-items="Model.CashFlowFactors">
                    <option value="">انتخاب عامل گردش نقدینگی</option>
                </select>
            </div>
        </div>
    </section>

    <section class="form-panel">
        <h2>تنظیمات دریافت بیعانه از طریق کارت‌خوان</h2>
        <p>حساب بانکی مقصد تسویه کارت‌خوان و کدهای مالی متناظر باید با مسئول مالی مجموعه تأیید شوند.</p>
        <div class="form-grid">
            <div class="field">
                <label asp-for="PosBankAccountId">حساب بانکی مقصد تسویه POS</label>
                <select asp-for="PosBankAccountId" asp-items="Model.BankAccounts">
                    <option value="">انتخاب حساب بانکی</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="PosAccountingOperationId">عملیات حسابداری کارت‌خوان</label>
                <select asp-for="PosAccountingOperationId" asp-items="Model.AccountingOperations">
                    <option value="">انتخاب عملیات حسابداری</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="PosCashFlowFactorId">عامل گردش نقدینگی کارت‌خوان</label>
                <select asp-for="PosCashFlowFactorId" asp-items="Model.CashFlowFactors">
                    <option value="">انتخاب عامل گردش نقدینگی</option>
                </select>
            </div>
        </div>
        <div class="calc-note">
            انتخاب مقادیر در این صفحه به معنی تأیید حسابداری نیست. تا زمان تأیید مسئول مالی، ثبت رسید کارت‌خوان در سامانه فعال نخواهد شد.
        </div>
    </section>

    <section class="form-panel">
        <h2>نگاشت درخواست فروش راهکاران</h2>
        <p>
            مرکز فروش، حوزه فروش و نحوه فروش از سرویس‌های مستند راهکاران دریافت می‌شوند.
            شناسه انبار، مرکز نگهداری، ارز، محصولات و واحد سنجش باید از اطلاعات واقعی محیط راهکاران وارد شوند.
            مقادیر نمونه مستندات در این فرم استفاده نشده‌اند.
        </p>
        <div class="form-grid">
            <div class="field">
                <label asp-for="SalesOfficeId">مرکز فروش</label>
                <select asp-for="SalesOfficeId" asp-items="Model.SalesOffices">
                    <option value="">انتخاب مرکز فروش</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="SalesAreaId">حوزه فروش</label>
                <select asp-for="SalesAreaId" asp-items="Model.SalesAreas">
                    <option value="">انتخاب حوزه فروش</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="SalesTypeId">نحوه فروش</label>
                <select asp-for="SalesTypeId" asp-items="Model.SalesTypes">
                    <option value="">انتخاب نحوه فروش</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="SalesInventoryId">شناسه انبار</label>
                <input asp-for="SalesInventoryId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="SalesPlantId">شناسه مرکز نگهداری</label>
                <input asp-for="SalesPlantId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="SalesCurrencyId">شناسه ارز</label>
                <input asp-for="SalesCurrencyId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="SalesPaymentAgreementId">شناسه روش توافق پرداخت (اختیاری)</label>
                <input asp-for="SalesPaymentAgreementId" type="number" min="1" />
            </div>
        </div>
        <div class="calc-note">
            شناسه‌های انبار، مرکز نگهداری، ارز و روش توافق پرداخت باید توسط مدیر راهکاران یا مسئول مالی تأیید شوند.
        </div>
    </section>

    <section class="form-panel">
        <h2>نگاشت محصولات کیک تولد</h2>
        <p>
            برای هر نوع کیک، شناسه محصول متناظر در راهکاران و شناسه واحد سنجش کیلوگرم را وارد کنید.
            مقدارها باید از اطلاعات واقعی راهکاران گرفته شوند.
        </p>
        <div class="form-grid">
            <div class="field">
                <label asp-for="CreamCakeProductId">شناسه محصول کیک خامه‌ای</label>
                <input asp-for="CreamCakeProductId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="CreamCakeUnitId">شناسه واحد کیک خامه‌ای (کیلوگرم)</label>
                <input asp-for="CreamCakeUnitId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="SemiFondantCakeProductId">شناسه محصول کیک نیمه‌فوندانت</label>
                <input asp-for="SemiFondantCakeProductId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="SemiFondantCakeUnitId">شناسه واحد کیک نیمه‌فوندانت (کیلوگرم)</label>
                <input asp-for="SemiFondantCakeUnitId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="FullFondantCakeProductId">شناسه محصول کیک تمام‌فوندانت</label>
                <input asp-for="FullFondantCakeProductId" type="number" min="1" />
            </div>
            <div class="field">
                <label asp-for="FullFondantCakeUnitId">شناسه واحد کیک تمام‌فوندانت (کیلوگرم)</label>
                <input asp-for="FullFondantCakeUnitId" type="number" min="1" />
            </div>
        </div>
    </section>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">ذخیره نگاشت‌ها</button>
    </div>
</form>
