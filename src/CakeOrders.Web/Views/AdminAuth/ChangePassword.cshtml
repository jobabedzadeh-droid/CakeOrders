@model CakeOrders.Web.ViewModels.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="page-heading">
    <div>
        <h1>تغییر رمز عبور</h1>
        <p>برای تغییر رمز، ابتدا رمز عبور فعلی را وارد کنید.</p>
    </div>

    <a asp-action="Profile" class="btn btn-secondary">
        بازگشت به پروفایل
    </a>
</div>

<section class="form-panel">
    <form asp-action="ChangePassword" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-field">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword"></span>
        </div>

        <div class="form-field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div class="form-field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                تغییر رمز عبور
            </button>
        </div>

    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}