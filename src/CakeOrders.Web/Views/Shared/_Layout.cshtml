<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CakeOrders</title>
    <link rel="stylesheet" href="~/lib/persian-datepicker/dist/css/persian-datepicker.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">✿</span><div><b>CakeOrders</b><small>سامانه مدیریت سفارش</small></div></div>
        <div class="nav-caption">منوی اصلی</div>
        <a class="nav-link" asp-controller="Home" asp-action="Index">▦ <span>داشبورد</span></a>
        <a class="nav-link" asp-controller="Orders" asp-action="Index">▤ <span>همه سفارش‌ها</span></a>
        <a class="nav-link" asp-controller="Orders" asp-action="Create">＋ <span>ثبت سفارش جدید</span></a>
        @if (User.IsInRole("Admin"))
        {
            <div class="nav-caption">تنظیمات مدیریت</div>

            <a asp-controller="UserManagement"
                asp-action="Index"
                class="nav-link">
                <span>♙</span>
                <span>مدیریت کاربران</span>
            </a>

            <a class="nav-link"
               asp-controller="Branches"
               asp-action="Index">
                <icon name="building-2" />
                <span>مدیریت شعب</span>
            </a>

            <a class="nav-link" asp-controller="CashRegisters" asp-action="Index">
                <icon name="calculator" />
                <span>مدیریت صندوق‌ها</span>
            </a>

            <a class="nav-link"
               asp-controller="PosTerminals"
               asp-action="Index">
                <icon name="credit-card" />
                <span>دستگاه‌های کارت‌خوان</span>
            </a>
        }
        
        <div class="nav-caption">در حال توسعه</div>
        <a class="nav-link" href="#" aria-disabled="true">◷ <span>سفارش‌های آنلاین</span></a>
        <a class="nav-link" href="#" aria-disabled="true">▧ <span>برنامه تولید و تحویل</span></a>
        <a class="nav-link" href="#" aria-disabled="true">▥ <span>گزارش‌ها</span></a>
        <div class="sidebar-bottom">نسخه توسعه<br />تنظیمات حساس فقط برای مدیر واردشده قابل دسترسی است.</div>
    </aside>
    <main class="main">
        <header class="topbar">
            <span>
                پنل مدیریت / <b>@ViewData["Title"]</b>
            </span>

            <details class="account-menu">
                <summary class="operator">
                    <i>
                        @(User.Identity?.Name?.FirstOrDefault().ToString() ?? "ک")
                    </i>

                    <span>@User.Identity?.Name</span>
                    <icon name="chevron-down" size="xs" />
                </summary>

                <div class="account-dropdown">
                    <div class="account-info">
                        <strong>@User.Identity?.Name</strong>
                        <small>
                            @(User.IsInRole("Admin") ? "مدیر سیستم" : "کاربر عملیاتی")
                        </small>
                    </div>

                    <a asp-controller="AdminAuth" asp-action="Profile">
                        <icon name="user-round" size="sm" />
                        پروفایل من
                    </a>

                    <a asp-controller="AdminAuth" asp-action="ChangePassword">
                        تغییر رمز عبور
                    </a>

                    <form asp-controller="AdminAuth"
                          asp-action="Logout"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit">
                            <icon name="log-out" size="sm" />
                            خروج از سامانه
                        </button>
                    </form>
                </div>
            </details>
        </header>
        <div class="content">@RenderBody()</div>
        <footer>CakeOrders · سامانه مدیریت سفارش قنادی</footer>
    </main>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/persian-date/dist/persian-date.min.js"></script>
    <script src="~/lib/persian-datepicker/dist/js/persian-datepicker.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>