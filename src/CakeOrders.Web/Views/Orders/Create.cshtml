@{
    ViewData["Title"] = "ثبت سفارش جدید";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-2">ثبت سفارش جدید</h4>
            <p class="text-muted">
                نوع سفارشی را که قصد ثبت آن را دارید انتخاب کنید.
            </p>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <i class="bi bi-cake2 fs-1 text-primary"></i>
                    </div>

                    <h5 class="card-title">سفارش کیک تولد</h5>

                    <p class="text-muted">
                        ثبت سفارش کیک تولد با مشخصات اختصاصی،
                        وزن، قیمت، طرح، تزئینات و تصاویر نمونه.
                    </p>

                    <a asp-controller="Orders"
                       asp-action="CreateBirthdayCake"
                       class="btn btn-primary w-100">
                        ثبت سفارش کیک تولد
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <i class="bi bi-box-seam fs-1 text-success"></i>
                    </div>

                    <h5 class="card-title">سفارش شیرینی</h5>

                    <p class="text-muted">
                        ثبت سفارش انواع شیرینی و محصولات قنادی.
                    </p>

                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            disabled>
                        به‌زودی
                    </button>

                </div>
            </div>
        </div>

    </div>
</div>