@model CakeOrders.Web.ViewModels.OrderCreateViewModel
@using CakeOrders.Domain.Entities
@{
    ViewData["Title"] = "ثبت سفارش جدید";
}
<div class="page-heading"><div><h1>ثبت سفارش جدید</h1><p>اطلاعات سفارش را وارد کنید؛ مبلغ نهایی در سمت سرور محاسبه می‌شود.</p></div><a class="btn btn-light" asp-action="Index">بازگشت به سفارش‌ها</a></div>
<form asp-action="Create" method="post" class="order-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <section class="form-panel"><h2>اطلاعات پایه</h2><div class="form-grid">
        <div class="field"><label asp-for="CustomerName"></label><input asp-for="CustomerName" placeholder="نام و نام خانوادگی" /><span asp-validation-for="CustomerName"></span></div>
        <div class="field"><label asp-for="CustomerPhone"></label><input asp-for="CustomerPhone" placeholder="09xxxxxxxxx" dir="ltr" /><span asp-validation-for="CustomerPhone"></span></div>
        <div class="field"><label asp-for="Channel"></label><select asp-for="Channel" asp-items="Html.GetEnumSelectList<OrderChannel>()"><option value="">انتخاب کنید</option></select></div>
        <div class="field"><label asp-for="OrderType"></label><select asp-for="OrderType" asp-items="Model.OrderTypes"><option value="">انتخاب نوع سفارش</option></select><span asp-validation-for="OrderType"></span></div>
        <div class="field"><label asp-for="CakeType"></label><select asp-for="CakeType" asp-items="Html.GetEnumSelectList<CakeType>()"></select></div>
        <div class="field"><label asp-for="DeliveryAt"></label><input asp-for="DeliveryAt" type="datetime-local" value="@Model.DeliveryAt.ToString("yyyy-MM-ddTHH:mm")" /><span asp-validation-for="DeliveryAt"></span></div>
    </div></section>
    <section class="form-panel"><h2>مشخصات کیک</h2><div class="form-grid">
        <div class="field"><label asp-for="RequestedWeightKg"></label><input asp-for="RequestedWeightKg" type="number" min="0.1" max="100" step="0.1" /><span asp-validation-for="RequestedWeightKg"></span></div>
        <div class="field"><label asp-for="PricePerKg"></label><input asp-for="PricePerKg" type="number" min="0" step="1000" /><span asp-validation-for="PricePerKg"></span></div>
        <div class="field"><label asp-for="SecondaryPricePerKg"></label><input asp-for="SecondaryPricePerKg" type="number" min="0" step="1000" /><span asp-validation-for="SecondaryPricePerKg"></span></div>
        <div class="field"><label asp-for="PrintType"></label><select asp-for="PrintType" asp-items="Model.PrintTypes"></select></div>
        <div class="field"><label asp-for="BackgroundColor"></label><input asp-for="BackgroundColor" placeholder="مثلاً سفید و صورتی" /></div>
        <div class="field"><label asp-for="MoldType"></label><select asp-for="MoldType" asp-items="Model.MoldTypes"><option value="">انتخاب قالب</option></select></div>
        <div class="field"><label asp-for="WritingLocation"></label><select asp-for="WritingLocation" asp-items="Model.WritingLocations"><option value="">انتخاب محل نوشته</option></select></div>
        <div class="field"><label>فیلینگ</label><div class="check-row"><label><input asp-for="HasBananaFilling" /> موز</label><label><input asp-for="HasWalnutFilling" /> گردو</label></div></div>
        <div class="field full"><label asp-for="DesignNotes"></label><textarea asp-for="DesignNotes" rows="3" placeholder="توضیحات سفارش، متن روی کیک و جزئیات طرح"></textarea><span asp-validation-for="DesignNotes"></span></div>
    </div></section>
    <section class="form-panel"><h2>هزینه‌ها و پرداخت</h2><div class="form-grid">
        <div class="field"><label asp-for="MacaronCost"></label><input asp-for="MacaronCost" type="number" min="0" step="1000" /></div>
        <div class="field"><label asp-for="FlowerCost"></label><input asp-for="FlowerCost" type="number" min="0" step="1000" /></div>
        <div class="field"><label asp-for="DummyCost"></label><input asp-for="DummyCost" type="number" min="0" step="1000" /></div>
        <div class="field"><label asp-for="PrintingCost"></label><input asp-for="PrintingCost" type="number" min="0" step="1000" /></div>
        <div class="field"><label asp-for="ShippingCost"></label><input asp-for="ShippingCost" type="number" min="0" step="1000" /></div>
        <div class="field"><label asp-for="OtherCost"></label><input asp-for="OtherCost" type="number" min="0" step="1000" /></div>
        <div class="field"><label asp-for="Discount"></label><input asp-for="Discount" type="number" min="0" step="1000" /><span asp-validation-for="Discount"></span></div>
        <div class="field"><label asp-for="DepositAmount"></label><input asp-for="DepositAmount" type="number" min="0" step="1000" /><span asp-validation-for="DepositAmount"></span></div>
        <div class="field"><label asp-for="ReferrerCode"></label><input asp-for="ReferrerCode" placeholder="کد معرف" /></div>
    </div><div class="calc-note">فرمول: وزن × قیمت هر کیلو + هزینه‌های جانبی − تخفیف. مبلغ نهایی هنگام ذخیره مجدداً سمت سرور محاسبه می‌شود.</div></section>
    <div class="form-actions"><a class="btn btn-light" asp-action="Index">انصراف</a><button class="btn btn-primary" type="submit">ثبت سفارش</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }