@model CakeOrders.Domain.Entities.Order
@using CakeOrders.Domain.Entities
@using CakeOrders.Web.Helpers
@{
    ViewData["Title"] = "جزئیات سفارش";
    var isBirthdayCake = Model.Kind == OrderKind.BirthdayCake;
    var cake = Model.CakeType switch { CakeType.Cream => "خامه‌ای", CakeType.SemiFondant => "نیمه فوندانت", _ => "تمام فوندانت" };
    var isWorkshopMember = ViewBag.IsWorkshopMember as bool? == true;
    var cashReceiptKey = Guid.NewGuid().ToString("N");
    var rahkaranOutbox = ViewBag.RahkaranSalesRequestOutbox as RahkaranSalesRequestOutbox;
    var rahkaranSyncText = rahkaranOutbox?.Status switch
    {
        RahkaranSalesRequestSyncStatus.Pending => "در صف ارسال",
        RahkaranSalesRequestSyncStatus.Processing => "در حال ارسال",
        RahkaranSalesRequestSyncStatus.Succeeded => "با موفقیت ثبت شد",
        RahkaranSalesRequestSyncStatus.NeedsReview => "نیازمند بررسی دستی",
        _ => "ثبت نشده"
    };
}
<div class="page-heading">
    <div>
        <h1>جزئیات سفارش</h1>
        <p>شماره سفارش: <b>@Model.OrderNumber</b></p>
    </div>
    <a class="btn btn-light" asp-action="Index">بازگشت به سفارش‌ها</a>
    @if (isBirthdayCake && !isWorkshopMember)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">ویرایش سفارش</a>
    }
    @if (!isWorkshopMember)
    {
        <a asp-controller="OrderPayments" asp-action="Start" asp-route-orderId="@Model.Id" class="btn btn-primary">درخواست پرداخت کارت‌خوان</a>
        <a asp-controller="OrderPayments" asp-action="History" asp-route-orderId="@Model.Id" class="btn btn-secondary">سوابق پرداخت</a>
    }
</div>
@if (TempData["Success"] is string message)
{
    <div class="alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-danger">@error</div>
}
@{
    var receiptOutboxes = ViewBag.RahkaranReceiptOutboxes as List<RahkaranReceiptOutbox>
        ?? new List<RahkaranReceiptOutbox>();
    string ReceiptStatusText(RahkaranReceiptSyncStatus status) => status switch
    {
        RahkaranReceiptSyncStatus.Pending => "در صف ارسال",
        RahkaranReceiptSyncStatus.Processing => "در حال ارسال",
        RahkaranReceiptSyncStatus.Succeeded => "با موفقیت ثبت شد",
        RahkaranReceiptSyncStatus.NeedsReview => "نیازمند بررسی دستی",
        _ => status.ToString()
    };
}

@if (receiptOutboxes.Count > 0)
{
    <section class="form-panel">
        <h2>رسیدهای بیعانه راهکاران</h2>
        <p class="text-muted">هر پرداخت موفق بیعانه، مستقل از سایر پرداخت‌ها، یک رسید مالی جداگانه دارد.</p>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>منبع دریافت</th>
                        <th>مبلغ (ریال)</th>
                        <th>وضعیت</th>
                        <th>شناسه رسید راهکاران</th>
                        <th>شماره رسید</th>
                        <th>توضیحات خطا</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in receiptOutboxes)
                    {
                        <tr>
                            <td>@(receipt.Source == RahkaranReceiptSource.Cash ? "نقدی" : "کارت‌خوان")</td>
                            <td>@receipt.Amount.ToString("N0")</td>
                            <td>@ReceiptStatusText(receipt.Status)</td>
                            <td>@(receipt.RemoteReceiptId ?? "—")</td>
                            <td>@(receipt.RemoteReceiptNumber ?? "—")</td>
                            <td>@(receipt.LastError ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
@if (rahkaranOutbox is not null)
{
    <section class="form-panel">
        <h2>همگام‌سازی درخواست فروش راهکاران</h2>
        <div class="detail-grid">
            <div><small>وضعیت همگام‌سازی</small><b>@rahkaranSyncText</b></div>
            <div><small>شناسه درخواست فروش راهکاران</small><b>@(rahkaranOutbox.RemoteSalesRequestId ?? Model.RahkaranSalesRequestId ?? "—")</b></div>
            <div><small>تعداد تلاش</small><b>@rahkaranOutbox.AttemptCount</b></div>
            <div><small>آخرین تلاش</small><b>@(rahkaranOutbox.LastAttemptAtUtc.HasValue ? PersianDateTime.Format(rahkaranOutbox.LastAttemptAtUtc.Value) : "—")</b></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(rahkaranOutbox.LastError))
        {
            <div class="alert-danger mt-3">@rahkaranOutbox.LastError</div>
        }
        @if (rahkaranOutbox.Status == RahkaranSalesRequestSyncStatus.NeedsReview)
        {
            <p class="text-muted">برای جلوگیری از ایجاد درخواست فروش تکراری، ارسال خودکار مجدد انجام نمی‌شود. ابتدا وضعیت سند در راهکاران بررسی شود.</p>
        }
    </section>
}
<section class="form-panel">
    <div class="detail-grid">
        <div><small>مشتری</small><b>@(Model.CustomerName ?? "—")</b></div>
        <div><small>شماره تماس</small><b>@(Model.CustomerPhone ?? "—")</b></div>
        <div><small>نوع سفارش</small><b>@(isBirthdayCake ? "کیک تولد" : "شیرینی")</b></div>
        @if (isBirthdayCake)
        {
            <div><small>نوع کیک</small><b>@cake</b></div>
        }
        <div><small>وضعیت</small><b>@(Model.RequestedDepositAmount > Model.DepositAmount && Model.Status == OrderStatus.PendingReview ? "در انتظار پرداخت بیعانه" : Model.Status.ToString())</b></div>
        @if (isBirthdayCake)
        {
            <div><small>وزن</small><b>@Model.RequestedWeightKg.ToString("N1") کیلوگرم</b></div>
            <div><small>قیمت هر کیلو</small><b>@Model.PricePerKg.ToString("N0")</b></div>
        }
        <div><small>زمان ثبت</small><b>@PersianDateTime.Format(Model.CreatedAtUtc)</b></div>
        <div><small>زمان تحویل</small><b>@PersianDateTime.Format(Model.DeliveryAt)</b></div>
        <div><small>مبلغ نهایی</small><b>@Model.FinalAmount.ToString("N0")</b></div>
        <div><small>بیعانه پرداخت‌شده</small><b>@Model.DepositAmount.ToString("N0")</b></div>
        <div><small>بیعانه درخواستی</small><b>@Model.RequestedDepositAmount.ToString("N0")</b></div>
        <div><small>وضعیت بیعانه</small><b>@(Model.RequestedDepositAmount <= 0 ? "بدون بیعانه" : Model.DepositAmount >= Model.RequestedDepositAmount ? "پرداخت کامل" : Model.DepositAmount > 0 ? "پرداخت ناقص" : "در انتظار پرداخت")</b></div>
        <div><small>مانده</small><b>@Model.RemainingAmount.ToString("N0")</b></div>
        <div><small>کانال</small><b>@(Model.Channel == OrderChannel.Online ? "آنلاین" : "حضوری")</b></div>
        <div><small>معرف</small><b>@(Model.Referrer is not null ? $"{Model.Referrer.FirstName} {Model.Referrer.LastName} ({Model.Referrer.Code})" : !string.IsNullOrWhiteSpace(Model.ReferrerCode) ? Model.ReferrerCode : "—")</b></div>
        @if (isBirthdayCake)
        {
            <div><small>قالب کیک</small><b>@(Model.MoldType ?? "—")</b></div>
            <div><small>محل نوشته</small><b>@(Model.WritingLocation ?? "—")</b></div>
            <div><small>متن روی کیک</small><b>@(Model.CakeText ?? "—")</b></div>
        }
    </div>
    @if (!isBirthdayCake)
    {
        <hr />
        <h3>اقلام سفارش شیرینی</h3>
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>محصول</th>
                            <th>کارگاه</th>
                            <th>مقدار</th>
                            <th>قیمت واحد</th>
                            <th>جمع</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Workshop.Name</td>
                                <td>@item.Quantity.ToString("N3") @item.Unit</td>
                                <td>@item.UnitPrice.ToString("N0")</td>
                                <td>@item.LineTotal.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">هنوز قلمی برای این سفارش ثبت نشده است.</p>
        }
    }
    @if (isBirthdayCake && (!string.IsNullOrWhiteSpace(Model.SampleImagePath) || !string.IsNullOrWhiteSpace(Model.PrintImagePath)))
    {
        <hr /><h3>تصاویر سفارش</h3><div class="order-image-grid">
        @if (!string.IsNullOrWhiteSpace(Model.SampleImagePath))
        {
            <div><b>تصویر نمونه کیک</b><img src="@Model.SampleImagePath" alt="تصویر نمونه کیک" /></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.PrintImagePath))
        {
            <div><b>تصویر چاپی</b><img src="@Model.PrintImagePath" alt="تصویر موردنظر برای چاپ" /></div>
        }
    </div>
}
@if (isBirthdayCake && !string.IsNullOrWhiteSpace(Model.DesignNotes))
{
    <hr />
    <h3>توضیحات</h3>
    <p>@Model.DesignNotes</p>
}
</section>


@if (!isWorkshopMember && Model.Status is not (OrderStatus.Cancelled or OrderStatus.Rejected) && Model.RemainingAmount > 0)
{
    <section class="form-panel">
        <h3>ثبت دریافت نقدی</h3>
        <p class="text-muted">ثبت این فرم به معنی تأیید دریافت واقعی وجه توسط اپراتور است.</p>
        <form asp-controller="OrderPayments" asp-action="ReceiveCash" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.Id" />
            <input type="hidden" name="idempotencyKey" value="@cashReceiptKey" />
            <div class="form-group">
                <label for="cashPurpose">نوع دریافت</label>
                <select id="cashPurpose" name="purpose" class="form-control" required>
                    @if (Model.RequestedDepositAmount > Model.DepositAmount)
                    {
                        <option value="@((int)PaymentPurpose.Deposit)">بیعانه</option>
                    }
                    @if (Model.RequestedDepositAmount <= Model.DepositAmount)
                    {
                        <option value="@((int)PaymentPurpose.Settlement)">تسویه</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="cashAmount">مبلغ دریافتی (ریال)</label>
                <input id="cashAmount" name="amount" type="number" min="1" max="@Model.RemainingAmount"
                       step="1" class="form-control" required />
            </div>
            <div class="form-group">
                <label for="cashReceiptReference">شماره رسید (اختیاری)</label>
                <input id="cashReceiptReference" name="receiptReference" maxlength="100" class="form-control" />
            </div>
            <div class="form-group">
                <label for="cashNotes">توضیحات (اختیاری)</label>
                <textarea id="cashNotes" name="notes" maxlength="1000" rows="2" class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-primary"
                    onclick="return confirm('آیا دریافت واقعی این مبلغ را تأیید می‌کنید؟');">
                تأیید دریافت وجه نقد
            </button>
        </form>
    </section>
}

@{
    var allowedTransitions = Model.Status switch
    {
        OrderStatus.PendingReview => new[]
        {
            OrderStatus.Confirmed,
            OrderStatus.Rejected,
            OrderStatus.Cancelled
        },
        OrderStatus.Confirmed => new[]
        {
            OrderStatus.InProduction,
            OrderStatus.Cancelled
        },
        OrderStatus.InProduction => new[]
        {
            OrderStatus.ReadyForDelivery,
            OrderStatus.Cancelled
        },
        OrderStatus.ReadyForDelivery => new[]
        {
            OrderStatus.Delivered
        },
        _ => Array.Empty<OrderStatus>()
    };
}

@if (!isWorkshopMember)
{
<section class="form-panel">
    <h3>تغییر وضعیت سفارش</h3>

    @if (allowedTransitions.Length > 0)
    {
        <form asp-action="UpdateStatus" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="OrderId" value="@Model.Id" />

            <div class="form-group">
                <label for="NewStatus">وضعیت جدید</label>
                <select name="NewStatus" id="NewStatus" class="form-control" required>
                    @foreach (var status in allowedTransitions)
                    {
                        <option value="@((int)status)">
                            @GetStatusName(status)
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="Note">توضیحات / دلیل تغییر وضعیت</label>
                <textarea name="Note"
                          id="Note"
                          class="form-control"
                          rows="3"
                          maxlength="1000"
                          placeholder="دلیل تأیید، رد یا توضیح تغییر وضعیت را وارد کنید..."
                          required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                ثبت تغییر وضعیت
            </button>
        </form>
    }
    else
    {
        <p class="text-muted">
            این سفارش در وضعیت نهایی قرار دارد و امکان تغییر وضعیت آن وجود ندارد.
        </p>
    }
</section>
}
@{
    var historyUserNames =
        ViewBag.StatusHistoryUserNames
        as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}
<section class="form-panel">
    <h3>تاریخچه تغییرات وضعیت</h3>

    @if (Model.StatusHistory.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>وضعیت قبلی</th>
                        <th>وضعیت جدید</th>
                        <th>تاریخ و زمان</th>
                        <th>تغییر‌دهنده</th>
                        <th>توضیحات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var history in Model.StatusHistory
                        .OrderByDescending(x => x.ChangedAtUtc))
                    {
                        var changedByName =
                            history.ChangedByUserId != null &&
                            historyUserNames.TryGetValue(
                                history.ChangedByUserId,
                                out var displayName)
                                ? displayName
                                : "نامشخص";

                        <tr>
                            <td>@GetStatusName(history.PreviousStatus)</td>
                            <td>@GetStatusName(history.NewStatus)</td>
                            <td>@PersianDateTime.Format(history.ChangedAtUtc)</td>
                            <td>@changedByName</td>
                            <td>@(history.Note ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">
            تاریخچه‌ای برای این سفارش ثبت نشده است.
        </p>
    }
</section>

@{
    var cashPayments = ViewBag.CashPayments as List<OrderCashPayment>
        ?? new List<OrderCashPayment>();
    var cashReceiverNames = ViewBag.CashReceiverNames as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}
<section class="form-panel">
    <h3>سوابق دریافت نقدی</h3>
    @if (cashPayments.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>تاریخ و زمان</th>
                        <th>نوع دریافت</th>
                        <th>مبلغ (ریال)</th>
                        <th>ثبت‌کننده</th>
                        <th>شماره رسید</th>
                        <th>توضیحات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cash in cashPayments)
                    {
                        <tr>
                            <td>@PersianDateTime.Format(cash.ReceivedAtUtc)</td>
                            <td>@(cash.Purpose == PaymentPurpose.Deposit ? "بیعانه" : "تسویه")</td>
                            <td>@cash.Amount.ToString("N0")</td>
                            <td>@(cashReceiverNames.TryGetValue(cash.ReceivedByUserId, out var receiverName) ? receiverName : "نامشخص")</td>
                            <td>@(cash.ReceiptReference ?? "—")</td>
                            <td>@(cash.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">هنوز دریافت نقدی برای این سفارش ثبت نشده است.</p>
    }
</section>

@{
    var orderChangeLogs =
        ViewBag.OrderChangeLogs as List<OrderChangeLog>
        ?? new List<OrderChangeLog>();

    var changeLogUserNames =
        ViewBag.OrderChangeLogUserNames
        as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<section class="form-panel">
    <h2>تاریخچه تغییرات سفارش</h2>

    @if (orderChangeLogs.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>تاریخ و ساعت</th>
                        <th>فیلد تغییرکرده</th>
                        <th>مقدار قبلی</th>
                        <th>مقدار جدید</th>
                        <th>تغییر‌دهنده</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var log in orderChangeLogs)
                    {
                        <tr>
                            <td>
                                @{
                                    var changedAtLocal = DateTime.SpecifyKind(
                                        log.ChangedAtUtc,
                                        DateTimeKind.Utc
                                    ).ToLocalTime();
                                }

                                @CakeOrders.Web.Helpers.PersianDateTime.Format(changedAtLocal)
                            </td>

                            <td>
                                <strong>@log.FieldName</strong>
                            </td>

                            <td>
                                @(log.OldValue ?? "—")
                            </td>

                            <td>
                                @(log.NewValue ?? "—")
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(log.ChangedByUserId)
                                    && changeLogUserNames.TryGetValue(
                                        log.ChangedByUserId,
                                        out var displayName))
                                {
                                    @displayName
                                }
                                else
                                {
                                    <span>نامشخص</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>هنوز تغییری برای این سفارش ثبت نشده است.</p>
    }
</section>

@functions {
    public static string GetStatusName(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.PendingReview => "در انتظار بررسی",
            OrderStatus.Confirmed => "تأیید شده",
            OrderStatus.Rejected => "رد شده",
            OrderStatus.InProduction => "در حال تولید",
            OrderStatus.ReadyForDelivery => "آماده تحویل",
            OrderStatus.Delivered => "تحویل شده",
            OrderStatus.Cancelled => "لغو شده",
            _ => status.ToString()
        };
    }
}