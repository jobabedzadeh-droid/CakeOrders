@model CakeOrders.Web.ViewModels.UserManagement.CreateUserViewModel

@{
    ViewData["Title"] = "ایجاد کاربر جدید";
}

<div class="page-heading">
    <div>
        <h1>ایجاد کاربر جدید</h1>
        <p>اطلاعات حساب کاربری را وارد کنید.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
</div>

<section class="form-panel">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid">
            <div class="form-field">
                <label asp-for="DisplayName">نام و نام خانوادگی</label>
                <input asp-for="DisplayName" />
                <span asp-validation-for="DisplayName"></span>
            </div>

            <div class="form-field">
                <label asp-for="UserName">نام کاربری</label>
                <input asp-for="UserName" autocomplete="off" />
                <span asp-validation-for="UserName"></span>
            </div>

            <div class="form-field">
                <label asp-for="PhoneNumber">شماره موبایل</label>
                <input asp-for="PhoneNumber" />
                <span asp-validation-for="PhoneNumber"></span>
            </div>

            <div class="form-field">
                <label asp-for="Email">ایمیل</label>
                <input asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-field">
                <label asp-for="Password">رمز عبور اولیه</label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-field">
                <label asp-for="Role">نقش کاربر</label>
                <select asp-for="Role">
                    <option value="User">کاربر عملیاتی</option>
                    <option value="Admin">مدیر سیستم</option>
                </select>
                <span asp-validation-for="Role"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                ثبت کاربر
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}