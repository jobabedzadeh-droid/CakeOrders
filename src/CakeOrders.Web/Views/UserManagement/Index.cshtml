@model IReadOnlyList<CakeOrders.Web.ViewModels.UserManagement.UserListItemViewModel>

@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="page-heading">
    <div>
        <h1>مدیریت کاربران</h1>
        <p>مشاهده و مدیریت حساب‌های کاربری سامانه</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + ایجاد کاربر جدید
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="form-panel">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>نام و نام خانوادگی</th>
                    <th>نام کاربری</th>
                    <th>موبایل</th>
                    <th>ایمیل</th>
                    <th>نقش</th>
                    <th>وضعیت</th>
                    <th>تاریخ ایجاد</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.DisplayName</td>
                        <td>@user.UserName</td>
                        <td>@(user.PhoneNumber ?? "—")</td>
                        <td>@(user.Email ?? "—")</td>
                        <td>@user.Role</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="status-badge status-success">فعال</span>
                            }
                            else
                            {
                                <span class="status-badge status-danger">غیرفعال</span>
                            }
                        </td>
                        <td>
                            @user.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")
                        </td>
                        <td>
                            <div class="table-actions">

                                <form asp-action="ToggleStatus"
                                      method="post"
                                      onsubmit="return confirm('آیا از تغییر وضعیت این حساب مطمئن هستید؟');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@user.Id" />

                                    @if (user.IsActive)
                                    {
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            غیرفعال‌سازی
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-success btn-sm">
                                            فعال‌سازی
                                        </button>
                                    }
                                </form>
                                <a asp-action="Edit"
                                   asp-route-id="@user.Id"
                                   class="btn btn-secondary btn-sm">
                                    ویرایش
                                </a>
                                <a asp-action="ResetPassword"
                                   asp-route-id="@user.Id"
                                   class="btn btn-secondary btn-sm">
                                    بازنشانی رمز
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Count == 0)
    {
        <p class="empty-state">هنوز کاربری ثبت نشده است.</p>
    }
</section>