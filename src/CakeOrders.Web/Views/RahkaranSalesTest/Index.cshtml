@model CakeOrders.Web.ViewModels.Integrations.Rahkaran.RahkaranSalesTestViewModel

@{
    ViewData["Title"] = "آزمایش درخواست فروش راهکاران";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">RAHKARAN SALES REQUEST TEST</span>
        <h1>آزمایش مستقیم درخواست فروش</h1>
        <p>ارسال کنترل‌شده یک درخواست واقعی به وضعیت در انتظار بررسی در راهکاران</p>
    </div>
    <a class="btn btn-secondary" asp-controller="RahkaranSettings" asp-action="Index">بازگشت به تنظیمات</a>
</div>

<div class="alert-danger">
    <strong>هشدار: این عملیات واقعی است، شبیه‌سازی نیست.</strong>
    با فشردن دکمه ارسال، یک درخواست فروش جدید در راهکاران ایجاد می‌شود.
    این صفحه محدودیت وضعیت سفارش، بیعانه و Outbox را دور می‌زند و هیچ رکوردی در سفارش یا Outbox داخلی تغییر نمی‌دهد.
    در صورت پاسخ مبهم، تا بررسی راهکاران دوباره ارسال نکنید.
</div>

@if (!string.IsNullOrWhiteSpace(Model.ResultMessage))
{
    <section class="form-panel">
        <h2>نتیجه آخرین تلاش</h2>
        <p>@Model.ResultMessage</p>
        @if (Model.HttpStatusCode.HasValue)
        {
            <p>HTTP Status: <strong>@Model.HttpStatusCode</strong></p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RemoteSalesRequestId))
        {
            <p>شناسه درخواست فروش راهکاران: <strong dir="ltr">@Model.RemoteSalesRequestId</strong></p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ResponseBody))
        {
            <details>
                <summary>مشاهده پاسخ خام سرویس</summary>
                <pre dir="ltr" style="white-space:pre-wrap;overflow-wrap:anywhere">@Model.ResponseBody</pre>
            </details>
        }
    </section>
}

<section class="form-panel">
    <h2>اطلاعات درخواست آزمایشی</h2>
    <p>
        سفارش فقط برای استفاده از هویت مشتری و نگاشت محصول انتخاب می‌شود.
        وزن و قیمت آزمایشی را مستقل وارد کنید؛ مبلغ درخواست برابر وزن ضربدر قیمت هر کیلو خواهد بود.
    </p>

    <form asp-action="Send" method="post">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field">
                <label asp-for="OrderId">سفارش مرجع و مشتری راهکاران</label>
                <select asp-for="OrderId">
                    <option value="">انتخاب سفارش</option>
                    @foreach (var order in Model.Orders)
                    {
                        <option value="@order.Id">
                            @order.OrderNumber — @order.CustomerName — Rahkaran ID: @order.RahkaranCustomerId — @order.CakeType
                        </option>
                    }
                </select>
                <span asp-validation-for="OrderId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="QuantityKg">وزن آزمایشی (کیلوگرم)</label>
                <input asp-for="QuantityKg" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="QuantityKg" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="PricePerKg">قیمت هر کیلو</label>
                <input asp-for="PricePerKg" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="PricePerKg" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Confirmation">تأیید ارسال واقعی</label>
                <input asp-for="Confirmation" autocomplete="off" placeholder="شماره سفارش انتخاب‌شده را عیناً وارد کنید" />
                <span asp-validation-for="Confirmation" class="text-danger"></span>
            </div>
        </div>

        <div class="calc-note">
            توضیحات درخواست با پیشوند TEST ONLY ارسال می‌شود تا در راهکاران قابل تشخیص باشد.
            شناسه نشانی پیش‌فرض از اطلاعات همگام‌سازی‌شده مشتری استخراج می‌شود.
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary"
                    onclick="return confirm('این عملیات یک درخواست فروش واقعی در راهکاران ایجاد می‌کند. آیا مطمئن هستید؟');">
                ارسال یک درخواست آزمایشی به راهکاران
            </button>
        </div>
    </form>
</section>
