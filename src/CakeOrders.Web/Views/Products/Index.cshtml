@model IReadOnlyList<CakeOrders.Web.ViewModels.ProductManagement.ProductListItemViewModel>
@using CakeOrders.Domain.Entities
@{
    ViewData["Title"] = "مدیریت محصولات";
}
<div class="page-header">
    <div><h1>مدیریت محصولات</h1><p>تعریف محصولات و کارگاه پیش‌فرض هر شعبه</p></div>
    <div class="page-actions">
        <a class="btn btn-secondary" asp-controller="ProductCategories" asp-action="Index">گروه‌های محصول</a>
        <a class="btn btn-primary" asp-action="Create">＋ محصول جدید</a>
    </div>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card">
<table class="table">
<thead><tr><th>کد</th><th>نام محصول</th><th>گروه</th><th>واحد</th><th>تخصیص شعب</th><th>وضعیت</th><th></th></tr></thead>
<tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Code</td><td>@item.Name</td><td>@item.CategoryName</td>
        <td>@(item.Unit switch { ProductUnit.Piece => "عدد", ProductUnit.Kilogram => "کیلوگرم", ProductUnit.Tray => "سینی", ProductUnit.Box => "جعبه", _ => "—" })</td>
        <td>@item.RoutingCount</td>
        <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
        <td><a asp-action="Edit" asp-route-id="@item.Id">ویرایش</a>
            <form asp-action="ToggleActive" method="post" class="inline-form">
                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" />
                <button type="submit" class="btn btn-link">@(item.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
            </form>
        </td>
    </tr>
}
</tbody>
</table>
@if (Model.Count == 0) { <p class="empty-state">هنوز محصولی ثبت نشده است.</p> }
</div>
