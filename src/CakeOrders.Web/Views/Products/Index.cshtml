@model IReadOnlyList<CakeOrders.Web.ViewModels.ProductManagement.ProductListItemViewModel>
@using CakeOrders.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "مدیریت محصولات";

    var categories = ViewBag.Categories as List<SelectListItem>
        ?? new List<SelectListItem>();

    string? search = ViewBag.Search as string;
    long? categoryId = ViewBag.CategoryId as long?;
    bool? isActive = ViewBag.IsActive as bool?;

    int page = (int)ViewBag.Page;
    int pageSize = (int)ViewBag.PageSize;
    int totalCount = (int)ViewBag.TotalCount;
    int totalPages = (int)ViewBag.TotalPages;
}

<div class="page-header">
    <div>
        <h1>مدیریت محصولات</h1>
        <p>تعریف محصولات و کارگاه پیش‌فرض هر شعبه</p>
    </div>

    <div class="page-actions">
        <a class="btn btn-secondary"
           asp-controller="ProductCategories"
           asp-action="Index">
            گروه‌های محصول
        </a>

        <a class="btn btn-primary" asp-action="Create">
            ＋ محصول جدید
        </a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="card mb-3">
    <form method="get" asp-action="Index">
        <div class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="form-label">جست‌وجو</label>
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="نام یا کد محصول..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">گروه محصول</label>
                <select name="categoryId"
                        class="form-select"
                        asp-items="categories">
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">وضعیت</label>
                <select name="isActive" class="form-select">
                    <option value="">همه</option>
                    <option value="true" selected="@(isActive == true)">فعال</option>
                    <option value="false" selected="@(isActive == false)">غیرفعال</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">تعداد در صفحه</label>
                <select name="pageSize" class="form-select">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        <option value="@size" selected="@(pageSize == size)">
                            @size
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">
                    فیلتر
                </button>
            </div>
        </div>
    </form>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            پاک کردن فیلترها
        </a>
    </div>
</div>

<div class="card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>فهرست محصولات</h3>
        <span>تعداد نتایج: @totalCount</span>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>کد</th>
                <th>نام محصول</th>
                <th>گروه</th>
                <th>واحد</th>
                <th>تخصیص شعب</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.CategoryName</td>

                    <td>
                        @(item.Unit switch
                        {
                            ProductUnit.Piece => "عدد",
                            ProductUnit.Kilogram => "کیلوگرم",
                            ProductUnit.Tray => "سینی",
                            ProductUnit.Box => "جعبه",
                            _ => "—"
                        })
                    </td>

                    <td>@item.RoutingCount</td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">غیرفعال</span>
                        }
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            ویرایش
                        </a>

                        <form asp-action="ToggleActive"
                              method="post"
                              class="inline-form"
                              onsubmit="return confirm('آیا از تغییر وضعیت محصول اطمینان دارید؟');">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id" value="@item.Id" />

                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                @(item.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")
                            </button>
                        </form>
                    </td>
                </tr>
            }

            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <p class="empty-state">محصولی با مشخصات انتخاب‌شده پیدا نشد.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">

            <span>
                صفحه @(page) از @totalPages
            </span>

            <nav>
                <ul class="pagination mb-0">

                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-categoryId="@categoryId"
                           asp-route-isActive="@isActive"
                           asp-route-pageSize="@pageSize"
                           asp-route-page="@(page - 1)">
                            قبلی
                        </a>
                    </li>

                    @for (int p = Math.Max(1, page - 2);
                          p <= Math.Min(totalPages, page + 2);
                          p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-categoryId="@categoryId"
                               asp-route-isActive="@isActive"
                               asp-route-pageSize="@pageSize"
                               asp-route-page="@(p)">
                                @(p)
                            </a>
                        </li>
                    }

                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-categoryId="@categoryId"
                           asp-route-isActive="@isActive"
                           asp-route-pageSize="@pageSize"
                           asp-route-page="@(page + 1)">
                            بعدی
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    }
</div>