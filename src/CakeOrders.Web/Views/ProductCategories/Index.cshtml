@model IReadOnlyList<CakeOrders.Web.ViewModels.ProductManagement.ProductCategoryEditViewModel>

@{
    ViewData["Title"] = "گروه‌های محصول";
    var counts = ViewBag.ProductCounts as Dictionary<long, int> ?? new Dictionary<long, int>();
}

<div class="page-header">
    <div>
        <h1>گروه‌های محصول</h1>
        <p>مدیریت دسته‌بندی‌های کاتالوگ</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">＋ گروه جدید</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>نام گروه</th>
                <th>تعداد محصول</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@counts.GetValueOrDefault(item.Id)</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">غیرفعال</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                ویرایش
                            </a>

                            <form asp-action="SetActive" method="post"
                                  onsubmit="return confirm('آیا از تغییر وضعیت این گروه اطمینان دارید؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />

                                @if (item.IsActive)
                                {
                                    <input type="hidden" name="isActive" value="false" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        غیرفعال کردن
                                    </button>
                                }
                                else
                                {
                                    <input type="hidden" name="isActive" value="true" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        فعال کردن
                                    </button>
                                }
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <p class="empty-state">هنوز گروهی ثبت نشده است.</p>
    }
</div>