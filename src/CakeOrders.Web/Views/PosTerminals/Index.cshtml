@model IReadOnlyList<CakeOrders.Domain.Entities.PosTerminal>
@{
    ViewData["Title"] = "مدیریت کارت‌خوان‌ها";
}
<div class="page-heading">
    <div><h1>مدیریت دستگاه‌های کارت‌خوان</h1><p>تنظیمات اتصال پایانه‌های سداد؛ فقط در اختیار مدیر سیستم</p></div>
    <a class="btn btn-primary" asp-action="Create">＋ افزودن دستگاه</a>
</div>
@if (TempData["Success"] is string message) { <div class="alert-success">@message</div> }
<section class="table-panel">
@if (Model.Count == 0)
{
    <div class="empty-state"><span>▣</span><h2>هنوز دستگاهی تعریف نشده است</h2><p>برای شروع، دستگاه کارت‌خوان صندوق را اضافه کنید.</p><a class="btn btn-primary" asp-action="Create">افزودن دستگاه</a></div>
}
else
{
    <div class="table-scroll"><table>
        <thead><tr><th>نام دستگاه</th><th>IP</th><th>پورت</th><th>نوع اتصال</th><th>شناسه پایانه</th><th>وضعیت</th><th>عملیات</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><b>@item.Name</b></td><td dir="ltr">@item.IpAddress</td><td dir="ltr">@item.Port</td>
                <td>@(item.ConnectionType == "LAN" ? "شبکه (LAN)" : "سریال")</td>
                <td>@(string.IsNullOrWhiteSpace(item.TerminalCode) ? "—" : item.TerminalCode)</td>
                <td><span class="status">@((item.IsActive) ? "فعال" : "غیرفعال")</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">ویرایش</a>
                    <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary">@(item.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
</section>